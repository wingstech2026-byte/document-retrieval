# Copy to .env for local use (never commit .env). Real values go in Vercel's Environment Variables.
MONGO_URI=mongodb://localhost:27017
DOCRETRIEVAL_DB=docretrieval
READ_ONLY=1                 # 1 = public site (search, ask, read); 0 = also upload and delete

# Upload limits (optional). Vercel functions accept request bodies of at most 4.5 MB.
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=500

# Optional language model for written answers. Leave empty to answer with direct quotations.
# Any OpenAI-compatible endpoint works (a hosted service or a local server such as Ollama).
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Optional embedding model for meaning-based and hybrid search. Leave empty for BM25 only.
EMBED_BASE_URL=
EMBED_MODEL=
EMBED_API_KEY=
